  m_Text: "\u6307\u4EE4\uFF08\u6240\u6709\u5173\u8054\u6309\u952E\u5747\u4E3A\u5DE6\u4FA7\u6309\u952E\uFF09\uFF1A\n\n\u6E38\u620F\u63A7\u5236\uFF1A\nCTRL+R 
    \u91CD\u7F6E\u6E38\u620F\nCTRL+T  \u542F\u505C\u8BA1\u65F6\n\n\u654C\u4EBA\u63A7\u5236\uFF08\u5747\u8981\u6309\u7740CTRL+E\uFF09\nS      
    \u9489\u6B7B/\u677E\u5F00\nF       \u8DDF\u968F\u73A9\u5BB6\n-       \u7F29\u5C0F\n+      
    \u653E\u5927\n\u7A7A\u683C    \u590D\u5236\nC       \u6E05\u9664\u590D\u5236\n\n\u73A9\u5BB6\u63A7\u5236\uFF1A\nCTRL+1 
    \u5207\u6362\u73A9\u5BB6\u6307\u793A\nCTRL+2  \u5207\u6362\u51C6\u661F\u6837\u5F0F\nCTRL+~ 
    \u65E0\u654C\u6A21\u5F0F\uFF08\u671F\u95F4\u65E0\u78B0\u649E\uFF09\n\u6EDA\u8F6E\u4E0A\u4E0B\u5207\u6362\u5C04\u901F\n\nCTRL+SHIFT+Q\n\u9000\u51FA\u6E38\u620F"
